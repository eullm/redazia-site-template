---
import { THEME, articleUrl, asset, formatDate, langOf, sectionLabel, sectionOf, sectionUrl, type Article } from '../lib/site';

interface Props { article: Article; size?: 'lead' | 'normal' | 'small' | 'row' | 'text'; eager?: boolean }
const { article, size = 'normal', eager = false } = Astro.props;
const lang = langOf(article);
const section = sectionOf(article);
const url = articleUrl(article);
const img = asset(article.data.image);
const showImage = img && size !== 'small' && size !== 'text';
const Tag = size === 'lead' ? 'h2' : 'h3';
---
<article class={`card ${size}`} data-home={THEME.home}>
  {showImage && (
    <a href={url} class="pic" tabindex="-1" aria-hidden="true">
      <img src={img} alt={article.data.image_alt || ''} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    </a>
  )}
  <div class="txt">
    {section && <a class="kicker" href={sectionUrl(section, lang)}>{sectionLabel(section, lang)}</a>}
    <Tag class="title"><a href={url}>{article.data.title}</a></Tag>
    {article.data.description && size !== 'small' && size !== 'text' && <p class="desc">{article.data.description}</p>}
    <p class="meta"><time datetime={article.data.date.toISOString()}>{formatDate(article.data.date, lang, size !== 'text')}</time></p>
  </div>
</article>

<style>
  .card { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .pic { display: block; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius); background: var(--paper); }
  .pic img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
  .card:hover .pic img { transform: scale(1.02); }
  .txt { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .title { margin: 0; font-size: 21px; overflow-wrap: anywhere; }
  .title a { text-decoration: none; }
  .title a:hover { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--accent); }
  .desc { margin: 0; color: var(--ink-2); font-size: 16px; }
  .lead .title { font-size: 36px; }
  .lead .desc { font-size: 18px; }
  .small { padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .small .title { font-size: 17px; }
  .row { display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: 24px; align-items: start; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .row .pic { grid-column: 2; grid-row: 1; aspect-ratio: 4 / 3; }
  .row .txt { grid-column: 1; grid-row: 1; }
  .row .title { font-size: 26px; }
  .text { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 4px 20px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .text .txt { display: contents; }
  .text .meta { grid-column: 1; grid-row: 1 / span 2; font-family: var(--mono); font-size: 13px; padding-top: 4px; }
  .text .kicker { grid-column: 2; }
  .text .title { grid-column: 2; font-size: 20px; }
  @media (max-width: 720px) {
    .lead .title { font-size: 27px; }
    .row { grid-template-columns: minmax(0, 1fr) 110px; gap: 14px; }
    .row .title { font-size: 19px; }
    .row .desc { display: none; }
    .text { grid-template-columns: 1fr; }
    .text .meta { grid-row: auto; }
  }
</style>
