---
import { SITE, sectionLabel, sectionUrl, t, type Lang } from '../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const p = SITE.publisher;
---
<article class="about">
  <h1>{s.aboutTitle}</h1>
  <p class="lead">{SITE.ai === 'automatic' ? s.aboutAutomatic : s.aboutAssisted}</p>
  <h2>{s.aboutHow}</h2>
  <ol>{s.aboutSteps.map((x) => <li>{x}</li>)}</ol>
  <p>{s.aboutErrors} <a href={`mailto:${SITE.contact}`}>{SITE.contact}</a>{s.aboutErrorsAfter}</p>
  {SITE.sections.length > 0 && (
    <>
      <h2>{s.sections}</h2>
      <p class="secs">{SITE.sections.map((x) => <a href={sectionUrl(x, lang)}>{sectionLabel(x, lang)}</a>)}</p>
    </>
  )}
  <h2>{s.publisher}</h2>
  <p>{p.url ? <a href={p.url} rel="noopener">{p.name}</a> : p.name}{[p.address, p.vat].filter(Boolean).map((x) => `, ${x}`).join('')}. {s.noCookies}</p>
  {SITE.credit !== false && <p class="credit">{s.poweredBy} <a href="https://redazia.com" rel="noopener">Redazia</a>.</p>}
</article>

<style>
  .about { max-width: 760px; margin: 0 auto; }
  h1 { font-size: 40px; margin: 0 0 16px; }
  h2 { font-size: 26px; margin: 36px 0 10px; }
  .lead { font: 21px/1.55 var(--article); }
  ol { padding-left: 22px; }
  li { margin-bottom: 10px; }
  a { color: var(--accent); }
  .secs { display: flex; flex-wrap: wrap; gap: 8px 16px; }
  .credit { color: var(--muted); font-size: 15px; }
  @media (max-width: 600px) { h1 { font-size: 30px; } }
</style>
