---
import { LANG_NAMES, LOCALES } from '../lib/i18n';
import { MONO_FONT } from '../lib/themes';
import { BASE, LANGS, asset, SITE, THEME, absolute, href, paths, sectionLabel, sectionUrl, t, tagline, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonld?: object;
}
const { lang, title, description, image, type = 'website', jsonld } = Astro.props;
const s = t(lang);
const tag = tagline(lang);
const fullTitle = title ? `${title} | ${SITE.name}` : tag ? `${SITE.name}: ${tag}` : SITE.name;
const desc = description || tag;
const canonical = absolute(Astro.url.pathname);
const ogImage = image ? absolute(asset(image)!) : undefined;
const path = Astro.url.pathname;
const home = href(lang);
const c = THEME.colors;
const accent = SITE.accent || c.accent;
const vars = [
  `--bg:${c.bg}`, `--paper:${c.paper}`, `--ink:${c.ink}`, `--ink-2:${c.ink2}`, `--muted:${c.muted}`, `--line:${c.line}`,
  `--accent:${accent}`, `--on-accent:${c.onAccent}`, `--ai:${c.ai}`, `--ai-bg:${c.aiBg}`,
  `--heading:${THEME.heading}`, `--body:${THEME.body}`, `--article:${THEME.articleBody}`, `--mono:${MONO_FONT}`,
  `--radius:${THEME.radius}`,
].join(';');
const others = LANGS.filter((l) => l !== lang);
const rss = href(lang, 'rss.xml');
---
<!doctype html>
<html lang={lang} style={vars} data-header={THEME.header} data-dark={THEME.dark ? '' : undefined}
      data-caps={THEME.uppercaseNav ? '' : undefined}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  {desc && <meta name="description" content={desc}>}
  <link rel="canonical" href={canonical}>
  {LANGS.length > 1 && LANGS.map((l) => <link rel="alternate" hreflang={l} href={absolute(href(l))}>)}
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href={rss}>
  <link rel="icon" href={`${BASE}/favicon.svg`} type="image/svg+xml">
  <meta name="color-scheme" content={THEME.dark ? 'dark' : 'light'}>
  <meta name="theme-color" content={c.bg}>
  <meta name="generator" content="Redazia">
  <meta property="og:site_name" content={SITE.name}>
  <meta property="og:type" content={type}>
  <meta property="og:title" content={title || SITE.name}>
  {desc && <meta property="og:description" content={desc}>}
  <meta property="og:url" content={canonical}>
  <meta property="og:locale" content={LOCALES[lang].replace('-', '_')}>
  {ogImage && <meta property="og:image" content={ogImage}>}
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'}>
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld).replace(/</g, '\\u003c')} />}
</head>
<body>
  <a class="skip" href="#main">{s.latest}</a>
  {SITE.ai === 'automatic' && (
    <div class="ai-banner" role="note">
      <div class="wrap">
        <span class="ai-dot" aria-hidden="true">AI</span>
        <span>{s.aiBanner}</span>
        <a href={href(lang, paths(lang).about)}>{s.aiBannerLink}</a>
        {SITE.credit !== false && <span class="credit">· {s.poweredBy} <a href="https://redazia.com" rel="noopener">Redazia</a></span>}
      </div>
    </div>
  )}
  <header class="site-header">
    <div class="wrap top">
      <a class="logo" href={home}>{SITE.name}</a>
      {tag && <p class="tagline">{tag}</p>}
      {others.length > 0 && (
        <nav class="langs" aria-label={s.languages}>
          {others.map((l) => <a href={href(l)} hreflang={l} lang={l}>{LANG_NAMES[l]}</a>)}
        </nav>
      )}
    </div>
    <nav class="sections" aria-label={s.sections}>
      <div class="wrap">
        <a href={home} aria-current={path === home || path === `${home}/` ? 'page' : undefined}>{s.latest}</a>
        {SITE.sections.map((x) => {
          const u = sectionUrl(x, lang);
          return <a href={u} aria-current={path.startsWith(u) ? 'page' : undefined}>{sectionLabel(x, lang)}</a>;
        })}
      </div>
    </nav>
  </header>
  <main id="main" class="wrap">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <p><strong>{SITE.name}</strong>{tag && <> · {tag}</>}</p>
      <p>
        <a href={href(lang, paths(lang).about)}>{s.about}</a> ·
        <a href={rss}>RSS</a> · <a href={`${BASE}/llms.txt`}>llms.txt</a> · <a href={`${BASE}/sitemap-index.xml`}>Sitemap</a>
        {SITE.credit !== false && <> · {s.poweredBy} <a href="https://redazia.com" rel="noopener">Redazia</a></>}
      </p>
      <p class="small">{s.noCookies}</p>
      <p class="small">© {new Date().getFullYear()} {SITE.publisher.url
        ? <a href={SITE.publisher.url} rel="noopener">{SITE.publisher.name}</a> : SITE.publisher.name}{[SITE.publisher.address, SITE.publisher.vat].filter(Boolean).map((x) => `, ${x}`).join('')}</p>
    </div>
  </footer>
</body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; background: var(--bg); }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 17px/1.6 var(--body); }
  a { color: inherit; }
  img { max-width: 100%; height: auto; display: block; }
  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 20px; }
  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 12px; top: 12px; z-index: 10; background: var(--bg); padding: 8px 12px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  h1, h2, h3 { font-family: var(--heading); line-height: 1.2; letter-spacing: -.01em; }

  .ai-banner { background: var(--ai); color: #fff; font: 14px/1.4 var(--body); }
  [data-dark] .ai-banner { color: #0b0f19; }
  .ai-banner .wrap { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; padding-top: 8px; padding-bottom: 8px; }
  .ai-banner a { color: inherit; font-weight: 600; }
  .ai-dot { color: var(--ai); background: #fff; font-weight: 800; font-size: 11px; padding: 1px 6px; border-radius: 4px; letter-spacing: .04em; }

  .site-header { border-bottom: 1px solid var(--line); }
  .site-header .top { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 20px; padding-top: 20px; padding-bottom: 16px; }
  .logo { font: 800 32px/1.05 var(--heading); text-decoration: none; letter-spacing: -.02em; }
  .tagline { margin: 0; color: var(--muted); font-size: 15px; }
  .langs { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; }
  .langs a { font-size: 14px; font-weight: 600; text-decoration: none; border: 1px solid var(--line); border-radius: 999px; padding: 5px 13px; }
  .langs a:hover { border-color: var(--ink); }
  .sections { border-top: 1px solid var(--line); }
  .sections .wrap { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; }
  .sections a { white-space: nowrap; padding: 12px; font-size: 15px; font-weight: 600; text-decoration: none; color: var(--ink-2); border-bottom: 3px solid transparent; }
  [data-caps] .sections a { text-transform: uppercase; font-size: 13px; letter-spacing: .06em; }
  .sections a:hover { color: var(--ink); }
  .sections a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--accent); }

  /* The newspaper header: the name centred and large, the tagline under it. */
  [data-header='masthead'] .site-header .top { grid-template-columns: 1fr auto 1fr; text-align: center; padding-top: 28px; }
  [data-header='masthead'] .logo { grid-column: 2; font-size: 48px; }
  [data-header='masthead'] .tagline { grid-column: 2; grid-row: 2; }
  [data-header='masthead'] .langs { grid-column: 3; grid-row: 1; justify-self: end; }
  [data-header='masthead'] .sections .wrap { justify-content: center; }
  [data-header='masthead'] .site-header { border-bottom: 3px double var(--line); }

  main.wrap { padding-top: 28px; padding-bottom: 56px; min-height: 50vh; }
  .kicker { font: 700 12px/1 var(--body); text-transform: uppercase; letter-spacing: .08em; color: var(--accent); text-decoration: none; }
  .meta { color: var(--muted); font-size: 14px; margin: 0; }
  .empty { padding: 48px 0; color: var(--muted); font-size: 18px; }
  .demo-note { margin: 0 0 20px; padding: 10px 14px; border: 1px dashed var(--line); border-radius: var(--radius); color: var(--muted); font-size: 14px; }
  .page-title { font-size: 40px; margin: 0 0 24px; }

  .site-footer { background: var(--paper); border-top: 1px solid var(--line); font-size: 14px; color: var(--ink-2); }
  .site-footer .wrap { padding-top: 28px; padding-bottom: 36px; }
  .site-footer p { margin: 0 0 10px; }
  .site-footer .small { color: var(--muted); font-size: 13px; }

  @media (max-width: 720px) {
    body { font-size: 16px; }
    .site-header .top, [data-header='masthead'] .site-header .top { grid-template-columns: 1fr auto; text-align: left; padding-top: 18px; }
    .logo, [data-header='masthead'] .logo { grid-column: 1; font-size: 28px; }
    .tagline, [data-header='masthead'] .tagline { grid-column: 1 / -1; grid-row: 2; }
    .langs, [data-header='masthead'] .langs { grid-column: 2; grid-row: 1; }
    /* Three languages or more: on their own row under the tagline. */
    .langs:has(a:nth-child(3)), [data-header='masthead'] .langs:has(a:nth-child(3)) { grid-column: 1 / -1; grid-row: 3; justify-content: flex-start; justify-self: start; }
    .tagline { overflow-wrap: anywhere; }
    [data-header='masthead'] .sections .wrap { justify-content: flex-start; }
    .page-title { font-size: 30px; }
  }
</style>
